---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/components/Footer.astro';

type Props = {
  frontmatter: {
    title: string;
    description?: string;
  };
};

const { title, description } = Astro.props.frontmatter;
---

<BaseLayout headProps={{ title, description }}>
  <!-- id is used by scripts/generate-pdf.js -->
  <article id="article-pdf-main">
    <slot />
  </article>

  <Footer slot='footer' />
</BaseLayout>

<style>
  article {
    /* Name: styled like twoism's header */
    :global(h1) {
      margin-bottom: 3em;

      color: var(--theme-sub-text);

      font-size: 1em;
    }

    :global(p, ul, table) {
      margin-block: 1em;
    }

    :global(ul) {
      padding-inline-start: 1.2em;
    }

    :global(hr) {
      margin-block: 3em;
    }

    /* Section titles: styled like twoism's "Notes:" heading */
    :global(h2) {
      margin-bottom: 0.5em;

      color: var(--theme-sub-text);

      font-size: 1em;
      font-weight: 400;
    }

    :global(h3) {
      margin-block: 2em 0.5em;

      font-size: 1.1em;
    }

    :global(h4) {
      margin-block: 1.5em 0;

      font-size: 1em;
    }

    /* Location / description line under a role */
    :global(h4 + p) {
      margin-top: 0;

      color: var(--theme-sub-text);
    }

    :global(th, td) {
      padding: 0;
      padding-inline-end: 3em;

      text-align: start;
    }

    :global(td) {
      color: var(--theme-sub-text);
    }
  }
</style>
